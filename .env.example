TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ALLOWED_USER_IDS=
PRINTER_HOST=xxx.xxx.xxx.xxx
PRINTER_PORT=9100
# Pixel width, not paper width. Check the printer self-test/manual.
PRINTER_WIDTH=576
PRINTER_DPI=203
PRINTER_CUT=false
# Explicit paper feed after each receipt, before cutting (0-255 lines).
PRINTER_FEED_LINES=3
# Print the template title (e.g. JIRA) at the top of each receipt.
PRINT_SOURCE_NAME=true
DRY_RUN=true

# Optional Jira Cloud integration
JIRA_BASE_URL=https://xxxxx.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Set for API tokens with scopes; leave empty for a token without scopes.
JIRA_CLOUD_ID=

# Optional weather forecast. Set your city; country code disambiguates names.
WEATHER_CITY=
WEATHER_COUNTRY_CODE=
